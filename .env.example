# Synthetic data only. Both demo logins use public credentials. Use fictional notes
# and records, including when running the optional seed in a dedicated Supabase project.
#
# Browser demo: leave all Supabase settings empty. Production / Vercel requires
# DEMO_SESSION_SECRET. Generate once with: openssl rand -hex 32
# Keep it private and stable across instances and deployments. Rotation invalidates
# all browser demo sessions and stored changes. Local development generates a key
# under .next/cache when this setting is empty.
DEMO_SESSION_SECRET=

# Supabase mode: set both values in the server environment. The publishable key
# can also be a legacy anon JWT. NEXT_PUBLIC_SUPABASE_URL and the matching
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY are supported.
# A partial configuration or an unavailable Supabase service returns an error.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional seed only: apply all SQL files in supabase/migrations in date order
# in the Supabase SQL editor. Then supply SUPABASE_SECRET_KEY or the legacy
# SUPABASE_SERVICE_ROLE_KEY to the seed process in a trusted shell and run:
# node --env-file=.env.local scripts/seed.mjs   (Node 22.18+)
# Set the privileged key only in that shell. The app uses the publishable key.
# Supabase email/password auth must be enabled. Provision identifiers as
# <username>@students.example.invalid with a corresponding dean_profiles row.
#
# Demo usernames: alina.volkova and mark.ivanov. Password: Atlas2026!
# Browser demo retains the latest four new submissions per student for 30 days.
# Read receipts last 30 days and sessions last eight hours. Notes: max 256 UTF-8 bytes.
